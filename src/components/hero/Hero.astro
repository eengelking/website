---
import { hero } from '../../data/hero';
---

<section class="hero">
  <div class="container">
    <p class="eyebrow hero-status">
      <span class="pulse" aria-hidden="true"></span> status: available, remote preferred
    </p>
    <div class="hero-card">
      <h1>{hero.name}</h1>
      <p class="hero-role mono tagline">{hero.tagline}</p>
      <p class="hero-subtext">{hero.subtext}</p>
      <img class="hero-photo" src="/images/ed-engelking.png" alt="" aria-hidden="true" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-8) 0 var(--space-6);
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .hero-card {
    position: relative;
    background: var(--color-hero);
    border: 1px solid var(--color-hero-border);
    border-radius: var(--radius);
    padding: var(--space-5);
    overflow: hidden;
  }

  .hero-photo {
    display: none;
  }

  .hero-card h1 {
    color: var(--color-hero-text);
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 0 rgba(232, 163, 61, 0.6);
    animation: pulse 2.4s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(232, 163, 61, 0.5); }
    70% { box-shadow: 0 0 0 8px rgba(232, 163, 61, 0); }
    100% { box-shadow: 0 0 0 0 rgba(232, 163, 61, 0); }
  }

  h1 {
    font-size: var(--text-4xl);
    max-width: 20ch;
  }

  .hero-role {
    font-size: var(--text-lg);
    color: var(--color-hero-role);
    margin-top: var(--space-2);
    max-width: 56ch;
  }

  .tagline {
    color: var(--color-accent);
  }

  .hero-subtext {
    max-width: 52ch;
    color: var(--color-hero-subtext);
    margin-top: var(--space-3);
    font-size: var(--text-lg);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse { animation: none; }
  }

  @media (min-width: 1040px) {
    .hero-photo {
      display: block;
      position: absolute;
      right: 0;
      bottom: 0;
      width: clamp(290px, 29vw, 430px);
      height: auto;
      z-index: 1;
      filter: drop-shadow(-8px 8px 8px rgba(6, 12, 20, 0.5));
    }
  }
</style>
